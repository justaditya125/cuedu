# Server Configuration
PORT=8000
NODE_ENV=production

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://cuedu.cutm.ac.in

# CRM Webhook URL (expects application/x-www-form-urlencoded POST body)
# Body fields: name, email, mobile, course, source
# Registration and contact data are sent directly to the CRM (no database).
CRM_WEBHOOK_URL=https://crm.cutmap.ac.in/api/public/inquiry/cuedu

# CRM Lookup API (retrieve registered details for the payment page)
# Public lookup supports both ?mobile= and ?email=
CRM_LOOKUP_URL=https://crm.cutmap.ac.in/api/public/inquiry/cuedu/lookup
CRM_API_KEY=your-crm-api-key

# ---------------------------------------------------------------------------
# OTP verification (mobile + email) on the registration form
# ---------------------------------------------------------------------------
# Set to "true" ONLY once you have confirmed both SMS and email delivery work.
# While false, registrations are accepted without verification.
OTP_REQUIRED=false

# Signs the proof-of-verification token. Without it a random key is generated
# per boot, so anyone mid-registration during a restart must verify again.
# Generate with: openssl rand -hex 32
OTP_TOKEN_SECRET=

# Optional tuning (defaults shown)
# OTP_TTL_MS=600000              code valid for 10 minutes
# OTP_RESEND_COOLDOWN_MS=60000   1 minute between sends
# OTP_MAX_ATTEMPTS=5             wrong guesses before a new code is needed
# OTP_MAX_SENDS_PER_HOUR=5       per mobile number / email address
# OTP_TOKEN_TTL_MS=1800000       verified state lasts 30 minutes

# SMS gateway (smslogin.co). TEMPLATEID is the registered DLT template id and
# is mandatory - without it the gateway rejects every message.
SMS_USERNAME=gramtarang
SMS_APIKEY=
SMS_TEMPLATEID=
# Two sender IDs are provisioned and route differently: the first attempt goes
# out on SMS_SENDERID, and every resend to the same number on
# SMS_SENDERID_RESEND. Swap these two values if the roles are the other way
# round. Leaving SMS_SENDERID_RESEND unset uses the primary for both.
SMS_SENDERID=GTIDSP
SMS_SENDERID_RESEND=GTIDSM
# Must match the registered DLT template text exactly; {otp} is substituted.
# SMS_OTP_TEMPLATE=Dear User,Your OTP for login is:{otp} With Regards,GTIDS IT Team

# Payment
PAYMENT_URL=https://pages.razorpay.com/pl_TDMcoOPMLuKJ9W/view
PAYMENT_AMOUNT=1000

# Razorpay webhook secret, as configured in the Razorpay Dashboard.
# While this is unset, /api/razorpay-webhook accepts UNSIGNED requests from
# anyone. Set it to enforce signature verification.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CRM payment-status API. Accepts JSON { mobile?, email?, paymentId, status, amount }
# with at least one of mobile/email to identify the student.
CRM_PAYMENT_STATUS_URL=https://crm.cutmap.ac.in/api/public/payments/cuedu/status
CRM_PAYMENT_API_KEY=your-crm-payment-api-key



# Email - sender + admin notifications
# In production, mail is sent via msmtp (sendmail interface). The SMTP settings
# below are used as a fallback only when msmtp is not available.
SMTP_EMAIL=alertsemail@cutmap.ac.in
SMTP_PASSWORD=your-smtp-password-or-app-password
ADMIN_EMAIL=admin1@example.com, admin2@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Logging
LOG_LEVEL=info
